ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL connection for Docker Compose
ConnectionStrings__LocalConnection=Host=db;Port=5432;Database=CuentaCorriente;Username=postgres;Password=postgres

# Mercado Pago subscription checkout
MercadoPago__AccessToken=
MercadoPago__WebhookSecret=
MercadoPago__PublicBaseUrl=https://example.com
# Optional: test buyer email, used only in Development
MercadoPago__TestPayerEmail=
MercadoPago__MonthlyAmount=17000
MercadoPago__CurrencyId=ARS

# Optional database vars used by compose
POSTGRES_DB=CuentaCorriente
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
