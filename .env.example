ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL connection for Docker Compose
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=cuentascorrientes;Username=postgres;Password=postgres

# Optional database vars used by compose
POSTGRES_DB=cuentascorrientes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
