ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL connection for Docker Compose
ConnectionStrings__LocalConnection=Host=db;Port=5432;Database=CuentaCorriente;Username=postgres;Password=postgres

# Optional database vars used by compose
POSTGRES_DB=CuentaCorriente
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
